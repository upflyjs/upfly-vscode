{
  "name": "upfly-vscode",
  "displayName": "Upfly",
  "description": "Every image in your workspace, the code that uses it, and what could be smaller.",
  "version": "1.0.0-dev",
  "publisher": "ramin",
  "private": true,
  "license": "MIT",
  "author": "Rinkal Kumar (https://github.com/ramin-010)",
  "homepage": "https://github.com/upflyjs/upfly-vscode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upflyjs/upfly-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/upflyjs/upfly-vscode/issues"
  },
  "icon": "media/icon.png",
  "categories": ["Other"],
  "keywords": ["image", "images", "optimize", "webp", "avif", "references", "unused images"],
  "type": "module",
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": ["workspaceContains:.upfly/manifest.json"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you have not trusted, Upfly runs none of the project's code and changes no file: a folder with an upfly.config.ts or upfly.config.js is not read, Optimize and Undo do nothing, and coding agents get no Upfly MCP server until you trust the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Upfly reads the project's files on disk with Node.js, which a virtual workspace does not have."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "upfly.auditWorkspace",
        "title": "Audit workspace",
        "category": "Upfly",
        "icon": "$(refresh)"
      },
      {
        "command": "upfly.showReport",
        "title": "Show report",
        "category": "Upfly",
        "icon": "$(output)"
      },
      {
        "command": "upfly.whereUsed",
        "title": "Where is this image used?",
        "category": "Upfly"
      },
      {
        "command": "upfly.cancel",
        "title": "Cancel the run",
        "category": "Upfly"
      },
      {
        "command": "upfly.openLocation",
        "title": "Open",
        "category": "Upfly"
      },
      {
        "command": "upfly.optimize",
        "title": "Optimize",
        "category": "Upfly"
      },
      {
        "command": "upfly.optimizeWorkspace",
        "title": "Optimize workspace",
        "category": "Upfly"
      },
      {
        "command": "upfly.applyPlan",
        "title": "Apply this plan",
        "category": "Upfly",
        "icon": "$(check)"
      },
      {
        "command": "upfly.planAgain",
        "title": "Plan again",
        "category": "Upfly",
        "icon": "$(refresh)"
      },
      {
        "command": "upfly.keepOriginals",
        "title": "Keep or remove the originals in this plan",
        "category": "Upfly"
      },
      {
        "command": "upfly.planAction",
        "title": "Take the next step",
        "category": "Upfly"
      },
      {
        "command": "upfly.review.show",
        "title": "Show the review",
        "category": "Upfly"
      },
      {
        "command": "upfly.review.acceptLine",
        "title": "Accept",
        "category": "Upfly",
        "icon": "$(check)"
      },
      {
        "command": "upfly.review.undoLine",
        "title": "Undo",
        "category": "Upfly",
        "icon": "$(discard)"
      },
      {
        "command": "upfly.review.acceptFile",
        "title": "Accept file",
        "category": "Upfly",
        "icon": "$(check-all)"
      },
      {
        "command": "upfly.review.undoFile",
        "title": "Undo file",
        "category": "Upfly",
        "icon": "$(discard)"
      },
      {
        "command": "upfly.review.acceptRun",
        "title": "Accept every change of the last run",
        "category": "Upfly",
        "icon": "$(check-all)"
      },
      {
        "command": "upfly.review.undoRun",
        "title": "Undo the whole last run",
        "category": "Upfly",
        "icon": "$(discard)"
      },
      {
        "command": "upfly.review.compare",
        "title": "Compare with before the run",
        "category": "Upfly",
        "icon": "$(diff)"
      },
      {
        "command": "upfly.review.bringBack",
        "title": "Bring back the original",
        "category": "Upfly",
        "icon": "$(reply)"
      },
      {
        "command": "upfly.review.open",
        "title": "Open",
        "category": "Upfly"
      },
      {
        "command": "upfly.planCancel",
        "title": "Cancel this plan",
        "category": "Upfly"
      },
      {
        "command": "upfly.pointAgents",
        "title": "Point coding agents at Upfly",
        "category": "Upfly"
      },
      {
        "command": "upfly.copyMcpSetup",
        "title": "Copy the MCP setup for Cursor or Windsurf",
        "category": "Upfly"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "upfly",
        "label": "Upfly"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "upfly",
          "title": "Upfly",
          "icon": "media/upfly-activitybar.svg"
        }
      ]
    },
    "views": {
      "upfly": [
        {
          "id": "upfly.audit",
          "name": "Audit"
        },
        {
          "id": "upfly.refs",
          "name": "Where it is used"
        },
        {
          "id": "upfly.review",
          "name": "Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "upfly.audit",
        "contents": "Upfly reads every image in this workspace and the code that uses each one, and measures what could be smaller. It changes no file.\n[Audit workspace](command:upfly.auditWorkspace)"
      },
      {
        "view": "upfly.refs",
        "contents": "Right-click an image in the Explorer and choose Where is this image used?, or choose one here.\n[Choose an image](command:upfly.whereUsed)"
      },
      {
        "view": "upfly.review",
        "contents": "No run to review. After Upfly applies a run, each line it changed shows here and in the code, with Accept and Undo.\n[Optimize workspace](command:upfly.optimizeWorkspace)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "upfly.whereUsed",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(avif|gif|jpe?g|png|svg|tiff?|webp)$/i",
          "group": "7_upfly@1"
        },
        {
          "command": "upfly.optimize",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(avif|gif|jpe?g|png|svg|tiff?|webp)$/i",
          "group": "7_upfly@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "upfly.whereUsed",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(avif|gif|jpe?g|png|svg|tiff?|webp)$/i",
          "group": "7_upfly@1"
        },
        {
          "command": "upfly.optimize",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(avif|gif|jpe?g|png|svg|tiff?|webp)$/i",
          "group": "7_upfly@2"
        }
      ],
      "view/title": [
        {
          "command": "upfly.auditWorkspace",
          "when": "view == upfly.audit",
          "group": "navigation@1"
        },
        {
          "command": "upfly.showReport",
          "when": "view == upfly.audit && upfly.hasAudit",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "upfly.whereUsed",
          "when": "viewItem == upfly.image",
          "group": "upfly@1"
        },
        {
          "command": "upfly.optimize",
          "when": "viewItem == upfly.image",
          "group": "upfly@2"
        },
        {
          "command": "upfly.review.acceptRun",
          "when": "viewItem == upfly.reviewRun",
          "group": "inline@1"
        },
        {
          "command": "upfly.review.undoRun",
          "when": "viewItem =~ /^upfly\\.reviewRun/",
          "group": "inline@2"
        },
        {
          "command": "upfly.review.acceptFile",
          "when": "viewItem == upfly.reviewFile || viewItem == upfly.reviewFile.changed",
          "group": "inline@1"
        },
        {
          "command": "upfly.review.undoFile",
          "when": "viewItem == upfly.reviewFile",
          "group": "inline@2"
        },
        {
          "command": "upfly.review.compare",
          "when": "viewItem =~ /^upfly\\.reviewFile/",
          "group": "inline@3"
        },
        {
          "command": "upfly.review.acceptLine",
          "when": "viewItem == upfly.reviewLine.pending || viewItem == upfly.reviewLine.changed",
          "group": "inline@1"
        },
        {
          "command": "upfly.review.undoLine",
          "when": "viewItem == upfly.reviewLine.pending",
          "group": "inline@2"
        },
        {
          "command": "upfly.review.bringBack",
          "when": "viewItem == upfly.reviewOriginal",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "upfly.cancel",
          "when": "upfly.running"
        },
        {
          "command": "upfly.openLocation",
          "when": "false"
        },
        {
          "command": "upfly.planAction",
          "when": "false"
        },
        {
          "command": "upfly.review.acceptLine",
          "when": "false"
        },
        {
          "command": "upfly.review.undoLine",
          "when": "false"
        },
        {
          "command": "upfly.review.acceptFile",
          "when": "false"
        },
        {
          "command": "upfly.review.undoFile",
          "when": "false"
        },
        {
          "command": "upfly.review.compare",
          "when": "false"
        },
        {
          "command": "upfly.review.bringBack",
          "when": "false"
        },
        {
          "command": "upfly.review.open",
          "when": "false"
        },
        {
          "command": "upfly.applyPlan",
          "when": "resourceScheme == upfly-plan"
        },
        {
          "command": "upfly.planAgain",
          "when": "resourceScheme == upfly-plan"
        },
        {
          "command": "upfly.keepOriginals",
          "when": "resourceScheme == upfly-plan"
        },
        {
          "command": "upfly.review.acceptRun",
          "when": "upfly.reviewing"
        },
        {
          "command": "upfly.review.undoRun",
          "when": "upfly.reviewing"
        },
        {
          "command": "upfly.planCancel",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "upfly.applyPlan",
          "when": "resourceScheme == upfly-plan",
          "group": "navigation@1"
        },
        {
          "command": "upfly.planAgain",
          "when": "resourceScheme == upfly-plan",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "lint": "biome check .",
    "comments:check": "node scripts/comment-check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run comments:check && npm run typecheck && npm test",
    "test:integration": "node scripts/build.mjs && vscode-test --label extension && vscode-test --label change && vscode-test --label agents",
    "test:untrusted": "node scripts/build.mjs && node scripts/untrusted-check.mjs",
    "test:exit": "node scripts/build.mjs && vscode-test --label exit && node scripts/exit-builds.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.20.1",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ajv": "8.20.0",
    "esbuild": "0.25.12",
    "jsonc-parser": "3.3.1",
    "mocha": "11.8.0",
    "typescript": "5.9.3",
    "upfly-core": "3.2.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "upfly": "3.2.0",
    "upfly-mcp": "3.2.0"
  }
}
